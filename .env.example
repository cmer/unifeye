# Copy to .env and fill in. Never commit .env. Lines marked REQUIRED have no usable default.

# --- Mode ------------------------------------------------------------------------
VANTAGE_MODE=real                 # real = UNVR; mock = simulated cameras (sign-in is still Zitadel)
# SEED_DEMO=1                     # mock mode only: create demo tags, groups and views once
APP_URL=https://vantage.example.com        # REQUIRED public https URL of Vantage
WEBRTC_PUBLIC_HOST=192.168.1.10            # REQUIRED address browsers use to reach this host on port 8189

# --- Zitadel OIDC (the only way to sign in) -----------------------------------------
OIDC_ISSUER=https://id.example.com         # REQUIRED exact issuer of your Zitadel instance
OIDC_CLIENT_ID=                            # REQUIRED client ID of the Vantage web application
# OIDC_CLIENT_SECRET=                      # only if the application uses "Code" (client secret) instead of PKCE
OIDC_ALLOWED_ORG_IDS=                      # REQUIRED comma-separated Zitadel organization IDs allowed to sign in
# OIDC_PROJECT_ID=                         # optional: also require at least one role in this Zitadel project
OIDC_SCOPES=openid profile email offline_access
BOOTSTRAP_ADMIN_ISSUER=https://id.example.com   # exact issuer + subject (user ID) of the first administrator
BOOTSTRAP_ADMIN_SUBJECT=
TOKEN_ENC_KEY=                             # REQUIRED  openssl rand -base64 32

# --- UniFi Protect (server-side only; a dedicated local Protect user) ----------------
PROTECT_HOST=192.168.1.1
PROTECT_USERNAME=vantage-viewer
PROTECT_PASSWORD=
# PROTECT_TLS_CA_FILE=/certs/unvr.pem      # certificate (or CA) of the UNVR, mounted from ./certs
# PROTECT_RTSPS_FINGERPRINT=               # SHA-256 fingerprint of that certificate, for the RTSPS relay
# PROTECT_NVR_ID=default

# --- MediaMTX (internal) -----------------------------------------------------------
MEDIAMTX_HOOK_SECRET=                      # REQUIRED  openssl rand -hex 24
MEDIAMTX_API_SECRET=                       # REQUIRED  openssl rand -hex 24

# --- Optional tuning (defaults shown) ------------------------------------------------
# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_HOURS=168
# OIDC_RECHECK_SECONDS=300        # how often each session is re-validated with Zitadel
# OIDC_MAX_STALE_SECONDS=1800     # suspend a session that could not be re-validated for this long
# REVOCATION_SWEEP_SECONDS=10     # worst-case delay before a revoked stream stops (max 30)
# PREVIEW_MINUTES=15
# MAX_WALL_STREAMS=9
# PLAYBACK_WINDOW_SECONDS=60
# CLIP_MAX_SECONDS=300
# EVENT_PREROLL_SECONDS=5
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=8
# MEDIA_CACHE_MAX_MB=2048
# AUDIT_RETENTION_DAYS=365
# LOG_LEVEL=info
