# Copy to .env and fill in. Never commit .env. Lines marked REQUIRED have no usable default.

# --- Mode ------------------------------------------------------------------------
UNIFEYE_MODE=real                 # real = UNVR; mock = simulated cameras (sign-in works the same)
# SEED_DEMO=1                     # mock mode only: create demo tags, groups and views once
APP_URL=https://unifeye.example.com        # REQUIRED public https URL of Unifeye
WEBRTC_PUBLIC_HOST=192.168.1.10            # REQUIRED address browsers use to reach this host on WEBRTC_PORT
# WEBRTC_PORT=8189                         # live video port, UDP and TCP; open it in the firewall

# --- How people sign in ----------------------------------------------------------------
# SIGN_IN_METHODS=oidc                     # any of oidc, local, cloudflare (comma separated); oidc and cloudflare can't be combined
# OIDC_DISPLAY_NAME=SSO                    # sign-in page button, "Continue with ..." (only shown when local is on too)
# OIDC_EMAIL_DOMAINS=example.com          # with oidc,local: addresses at these domains go straight to the identity provider, never a password
# LOCAL_APP_URL=https://cameras.lan        # with local: a second https address for password sign-in (e.g. the LAN address behind Cloudflare)
# SMTP_URL=smtps://user:pass@smtp.example.com:465   # outgoing mail; with local, enables email sign-in codes (smtp://...:587 uses STARTTLS)
# MAIL_FROM=Unifeye <cameras@example.com>  # with SMTP_URL: the From address on outgoing email
# CF_ACCESS_TEAM_DOMAIN=acme.cloudflareaccess.com   # with cloudflare: your Zero Trust team domain
# CF_ACCESS_AUD=                           # with cloudflare: the Access application's Audience (AUD) tag
# CF_ACCESS_ORIGIN_SECRET=                 # with cloudflare: openssl rand -hex 24; Cloudflare adds it as X-Unifeye-Origin-Secret (required with local)
# CF_ACCESS_RECHECK_SECONDS=300            # with cloudflare: a session not seen through Access this long is suspended (max 3600)

# --- OpenID Connect (SIGN_IN_METHODS includes oidc) ------------------------------------
OIDC_ISSUER=https://id.example.com         # REQUIRED exact issuer, as in the provider's discovery document
OIDC_CLIENT_ID=                            # REQUIRED client ID of the Unifeye web application
# OIDC_CLIENT_SECRET=                      # only for a confidential client; leave unset to use PKCE alone
OIDC_ADMIT_CLAIM=groups                    # REQUIRED ID token claim checked at sign-in (dotted paths allowed)
OIDC_ADMIT_VALUES=unifeye                  # comma-separated accepted values; empty = claim must just be present
# OIDC_ADMIT_ANY=1                         # instead of the two above: admit everyone the provider lets through
# OIDC_GROUPS_CLAIM=                       # claim that puts people into Unifeye groups; default OIDC_ADMIT_CLAIM, "none" = off
OIDC_SCOPES=openid profile email offline_access   # add any scope your provider needs to put the claim in the ID token
# OIDC_AUTH_PARAMS=                        # extra sign-in request parameters, e.g. access_type=offline&prompt=consent for Google
BOOTSTRAP_ADMIN_ISSUER=https://id.example.com   # exact issuer + subject (user ID) of the first administrator
BOOTSTRAP_ADMIN_SUBJECT=
TOKEN_ENC_KEY=                             # REQUIRED with oidc  openssl rand -base64 32

# --- UniFi Protect (server-side only; a dedicated local Protect user) ----------------
PROTECT_HOST=192.168.1.1
PROTECT_USERNAME=unifeye-viewer
PROTECT_PASSWORD=
# PROTECT_TLS_CA_FILE=/certs/unvr.pem      # certificate (or CA) of the UNVR, mounted from ./certs
# PROTECT_RTSPS_FINGERPRINT=               # SHA-256 fingerprint of that certificate, for the RTSPS relay
# PROTECT_NVR_ID=default
# DEFAULT_CAMERA_USERNAME=admin          # login for cameras switched to "From the camera" (Admin > Live video)
# DEFAULT_CAMERA_PASSWORD=

# --- MediaMTX (internal) -----------------------------------------------------------
MEDIAMTX_HOOK_SECRET=                      # REQUIRED  openssl rand -hex 24 (at least 32 characters)
MEDIAMTX_API_SECRET=                       # REQUIRED  openssl rand -hex 24 (at least 32 characters)
# HOOK_PORT=3001                           # where MediaMTX calls Unifeye's auth hook; never publish or proxy it

# --- Optional tuning (defaults shown) ------------------------------------------------
# SESSION_IDLE_MINUTES=720
# SESSION_ABSOLUTE_HOURS=168
# OIDC_RECHECK_SECONDS=300        # how often each session is re-validated with the identity provider
# OIDC_MAX_STALE_SECONDS=1800     # suspend a session that could not be re-validated for this long
# REVOCATION_SWEEP_SECONDS=10     # worst-case delay before a revoked stream stops (max 30)
# PREVIEW_MINUTES=15
# MAX_WALL_STREAMS=9
# WALL_PLAYBACK_STREAMS=4        # wall tiles that play recorded video at once when rewinding; the rest show stills
# PLAYBACK_WINDOW_SECONDS=60
# SCRUB_PRELOAD_MS=500          # rest this long while dragging a camera's timeline and that moment starts loading (0: off)
# CLIP_MAX_SECONDS=7200
# CLIP_EXPORT_PARALLEL=3        # five-minute pieces of a long clip fetched from the recorder at once
# CLIP_MATCH_RESOLUTION=1       # resize adaptive recording's low-resolution stretches so a clip plays at one size
# VIDEO_ENCODER=auto            # auto | cpu | vaapi | nvenc | videotoolbox (auto: a GPU if one works, else the CPU)
# VAAPI_DEVICE=                 # e.g. /dev/dri/renderD128; unset tries every render node
# EVENT_PREROLL_SECONDS=5
# BACKUP_RETENTION_DAYS=14
# BACKUP_HOUR_UTC=8
# MEDIA_CACHE_MAX_MB=2048
# AUDIT_RETENTION_DAYS=365
# LOG_LEVEL=info
# UPDATE_CHECK=on                 # ask GitHub a few times a day whether a newer Unifeye exists; off = never
