# Local development only: mock cameras, throwaway test sign-in provider (scripts/test-oidc-provider.ts).
UNIFEYE_MODE=mock
SEED_DEMO=1
APP_URL=http://localhost:3000
# Add `local` to try password accounts too: SIGN_IN_METHODS=oidc,local (first admin: pnpm unifeye create-admin <name>)
# SIGN_IN_METHODS=oidc,local
OIDC_ISSUER=http://localhost:9911
OIDC_ALLOW_INSECURE_ISSUER=1
OIDC_CLIENT_ID=unifeye-dev
OIDC_ADMIT_CLAIM=groups
OIDC_ADMIT_VALUES=unifeye
BOOTSTRAP_ADMIN_ISSUER=http://localhost:9911
BOOTSTRAP_ADMIN_SUBJECT=dev-admin
TOKEN_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MEDIAMTX_HOOK_SECRET=dev-hook
MEDIAMTX_API_SECRET=dev-api
